# Every variable NOT commented out below is mandatory — boot fails fast if one
# is missing or malformed (see src/config/env.validation.ts). Some are mandatory
# only when NODE_ENV=production; those are marked "REQUIRED IN PRODUCTION" and
# left uncommented with a local-development value.

# App
NODE_ENV=development
PORT=3000

# Database (Phase 1)
DATABASE_URL=postgres://queerpulse:queerpulse@localhost:5432/queerpulse

# Database TLS (secure by default in production; verification ON).
# Applies to BOTH the app and the migration CLI — see src/config/database-ssl.ts.
#
# DATABASE_SSL overrides negotiation explicitly: true | false.
# DATABASE_SSL=false
# DATABASE_SSL_CA=/path/to/ca.pem            # inline PEM or a file path
# DATABASE_SSL_INSECURE=true                 # keep TLS, skip cert verification
#
# MANAGED POSTGRES (Railway, Render, Fly, ...): the default — TLS on with
# verification — will NOT connect, and the app crash-loops with no useful error.
# Pick the line that matches how you reach the database:
#
#   Private network (e.g. postgres.railway.internal): the server speaks
#   plaintext, so TLS must be off. Traffic never leaves the provider's network.
#     DATABASE_SSL=false
#
#   Public proxy / external host: the server presents a self-signed cert, so
#   verification must be relaxed. The channel is still encrypted.
#     DATABASE_SSL_INSECURE=true
#
# Prefer DATABASE_SSL_CA over DATABASE_SSL_INSECURE wherever the provider
# publishes a CA bundle — that keeps verification on.

# Database connection pool / timeouts (pg). Defaults shown.
# DATABASE_POOL_MAX=10
# DATABASE_POOL_MIN=0
# DATABASE_CONNECTION_TIMEOUT_MS=10000
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# Slow-query logging (TypeORM maxQueryExecutionTime): LOGS (never kills) any
# query slower than this, well ahead of DATABASE_STATEMENT_TIMEOUT_MS above.
# DATABASE_SLOW_QUERY_THRESHOLD_MS=500

# Frontend origin allowlist. REQUIRED IN PRODUCTION.
#
# Comma-separated list of EXACT origins: scheme + host (+ port), NO path and NO
# trailing slash — this is a strict allowlist matched against the browser's
# `Origin` header, which never carries a trailing slash. It gates both HTTP CORS
# and the socket.io chat handshake. Boot fails if an entry is not an exact origin.
#   good: https://queerpulse.com,https://www.queerpulse.com
#   bad:  https://queerpulse.com/          (trailing slash)
#   bad:  queerpulse.com                   (no scheme)
#
# The FIRST entry is the canonical origin: it is where OAuth sign-in redirects
# land. Additional entries are accepted but never redirected to.
FRONTEND_URL=http://localhost:5173

# REQUIRED IN PRODUCTION. This API's own public origin. Image URLs in every
# response are built from it, so a wrong value silently produces unreachable
# images rather than an error.
API_URL=http://localhost:3000

# Auth — JWT. Both secrets are mandatory, must be at least 32 characters, and
# must differ from each other (identical secrets allow access/refresh token
# confusion). Generate real ones with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-0000000000000000
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-1111111111111111
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Auth — Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Cookies
#
# COOKIE_DOMAIN is the `Domain` attribute of the auth cookies — a bare domain,
# not a URL (no scheme, port or path).
#
# LEAVE THIS UNSET. That is the correct value in production too, not just
# locally. It used to say a leading-dot parent domain was required for the
# frontend-on-queerpulse.com / API-on-api.queerpulse.com topology. That was
# WRONG: the auth cookies are httpOnly, so the SPA never reads them — only the
# API does. A host-only cookie set by api.queerpulse.com is returned to
# api.queerpulse.com on every `credentials: 'include'` fetch, because SameSite
# gates on the registrable domain and those two are same-site. It already works.
#
# Setting COOKIE_DOMAIN=.queerpulse.com instead broadcasts a 30-day refresh
# token to EVERY current and future subdomain — staging, status pages, any
# third-party-hosted CNAME. One XSS or takeover anywhere under the parent leaks
# 30 days of session. Only set this if the frontend ever moves to a host that is
# genuinely not same-site with the API, and weigh that cost first.
#
# Both `COOKIE_DOMAIN=` and omitting the line entirely mean "unset".
#
# Cookies are always SameSite=Lax. That is correct for this same-parent-domain
# topology and is deliberately NOT loosened — do not change it to `None` unless
# the frontend moves to a different registrable domain.
COOKIE_DOMAIN=

# Membership
# How many invites a member may create per calendar month. Optional; defaults
# to 5 (src/config/app.config.ts). A per-member override
# (users.invite_monthly_quota) wins over this global default when set.
# INVITE_MONTHLY_QUOTA=5

# Bootstrap — Genesis (first-admin). OPTIONAL and normally UNSET.
#
# Set this ONLY for the one-time founder bootstrap: while it is set, the
# self-disabling `/genesis` flow lets the matching email claim the first admin
# account; with it unset the genesis endpoints 404 (the correct, safe state).
# UNSET it again immediately after the first admin exists — leaving it set keeps
# a live bootstrap path open. The house/system account it creates stays editable
# via admin/bots afterwards.
# GENESIS_EMAIL=founder@queerpulse.example

# Data-retention crons — all OPTIONAL, production-safe defaults shown. Thresholds
# in DAYS; validated as positive numbers at boot (src/config/retention.config.ts).
# DATA_EXPORT_RETENTION_DAYS=30              # age at which an export archive's
#                                            # JSONB payload is nulled + marked expired
# NOTIFICATION_RETENTION_DAYS=90             # age at which READ notifications are
#                                            # deleted (unread are never deleted)
# PUSH_SUBSCRIPTION_STALE_DAYS=90            # prune push subs not delivered to within
#                                            # this window (dead 404/410 pruned inline)
# RETENTION_BATCH_SIZE=1000                  # rows removed/updated per statement
# RETENTION_MAX_BATCHES_PER_RUN=50           # hard cap on batches per cron tick

# Object storage — Railway Buckets. ALL FIVE ARE REQUIRED IN PRODUCTION:
# profile avatars and every upload route depend on them, and left unset the app
# boots healthy and then fails uploads per-request for users.
#
# Link a Bucket to this service in the Railway dashboard and these five are
# injected automatically; set them by hand only for local development.
AWS_ENDPOINT_URL=https://storage.railway.app
AWS_DEFAULT_REGION=auto
AWS_S3_BUCKET_NAME=queerpulse-dev
AWS_ACCESS_KEY_ID=your-bucket-access-key-id
AWS_SECRET_ACCESS_KEY=your-bucket-secret-access-key

# Video — Mux. Optional while the "cinema" feature ships disabled
# (src/launchedFeatures.ts). Setting launchedFeatures.cinema.launched = true
# makes the first three MANDATORY at boot in every environment.
#
# Mux is also all-or-nothing: if ANY MUX_* var is set, MUX_TOKEN_ID,
# MUX_TOKEN_SECRET and MUX_WEBHOOK_SECRET must all be set too, and the two
# signing vars must be set together (they enable signed playback).
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_WEBHOOK_SECRET=
# MUX_SIGNING_KEY_ID=
# MUX_SIGNING_PRIVATE_KEY=

# Observability / feature flags (all optional)
# SENTRY_DSN=                                # enables Sentry error reporting when set
# LOG_LEVEL=info                             # pino log level (info, debug, ...)
# LOG_PRETTY=true                            # pino-pretty output; defaults on when
#                                            # NODE_ENV=development. NEVER set this in a
#                                            # deployed environment — pino-pretty is a
#                                            # devDependency and is absent from the
#                                            # production image, so it crashes at boot.
# ENABLE_SWAGGER=true                        # serve the OpenAPI/Swagger UI

# Web Push (VAPID) — generate once with `npx web-push generate-vapid-keys`.
# Optional overall; if you set any, set all three.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@queerpulse.example

# Transactional email (SMTP). Powers the mailer (draft resume links, and future
# email flows). ALL OPTIONAL: with none set, the mailer runs LOG-ONLY — it builds
# each message and logs it but does NOT deliver (the safe dev/test default).
# To deliver for real, set EITHER a full connection string in SMTP_URL, OR the
# discrete SMTP_HOST/PORT/USER/PASSWORD fields. Credentials are yours to supply
# (your provider's) — never commit real values.
#   SMTP_URL takes precedence over the discrete fields when both are set.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false                          # 'true' for implicit TLS (port 465)
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=QueerPulse <hello@queerpulse.example>   # From header on every email

# Prometheus metrics — bearer token guarding GET /metrics (min 16 chars).
# Optional in every environment: unset leaves the endpoint open (we rely on
# Railway's private network for observability). Set it to require a bearer
# token and point your scrape config's Authorization header at it.
# METRICS_TOKEN=

# Multi-replica gate. This app is SINGLE-REPLICA ONLY: the throttler counters,
# socket.io fan-out (no Redis adapter) and presence map all live in process
# memory. Declaring more than one replica/worker fails fast at boot unless you
# explicitly acknowledge it. REPLICA_COUNT (or the de-facto WEB_CONCURRENCY) is
# the declared count; set ALLOW_MULTI_REPLICA=true ONLY after wiring the shared
# stores (Redis throttler storage + @socket.io/redis-adapter + shared presence).
# REPLICA_COUNT=1
# ALLOW_MULTI_REPLICA=false
